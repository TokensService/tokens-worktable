diff --git a/packages/host/webserver/tests/webserver.spec.ts b/packages/host/webserver/tests/webserver.spec.ts
index b7ac506b17..d9d1080099 100644
--- a/packages/host/webserver/tests/webserver.spec.ts
+++ b/packages/host/webserver/tests/webserver.spec.ts
@@ -378,4 +378,78 @@ describe('real Loader composition', () => {
       root = firstRoot
     }
   })
+
+  it('runs pre-dispatch guards over routes, the fallback seat, and upgrades', { timeout: 60_000 }, async () => {
+    const loaded = await loadComposition()
+    const server = loaded.webServer
+    const port = server.port
+    server.register({ kind: 'exact', path: '/probe', handler: (_req, res) => { res.writeHead(200); res.end('EXACT') } })
+    server.registerFallback((_req, res) => { res.writeHead(200); res.end('SHELL') })
+
+    // Inspector arms are optional: an upgrade-only guard never sees HTTP
+    // requests and an http-only guard never sees upgrades.
+    const disposeUpgradeOnly = server.registerGuard({ upgrade: () => false })
+    const disposeHttpOnly = server.registerGuard({ http: () => false })
+    // Deny everything under /locked; pass anything else.
+    const disposeDeny = server.registerGuard({
+      http: async (req, res) => {
+        await Promise.resolve()
+        if ((req.url ?? '').startsWith('/locked')) {
+          res.writeHead(401)
+          res.end('DENIED')
+          return true
+        }
+        return false
+      },
+      upgrade: (req) => (req.url ?? '').startsWith('/locked'),
+    })
+
+    expect(await request(port, '/locked/route')).toMatchObject({ status: 401, body: 'DENIED' })
+    expect((await request(port, '/locked/deep', { method: 'POST' })).status).toBe(401)
+    expect(await request(port, '/probe')).toMatchObject({ status: 200, body: 'EXACT' })
+    expect((await request(port, '/no/such/route')).body).toContain('SHELL')
+
+    // Upgrade guards: a refusal destroys the socket without negotiation; a
+    // passing upgrade reaches the registered route.
+    const disposeUpgradeRoute = server.registerUpgrade({
+      path: '/events',
+      handler: (_req, socket) => {
+        socket.write('HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: dsh-test\r\n\r\n')
+      },
+    })
+    const accepted = await upgrade(port, '/events')
+    accepted.destroy()
+
+    const refusedUpgrade = async (path: string): Promise<void> => {
+      const socket = connect(port, '127.0.0.1')
+      await once(socket, 'connect')
+      const closed = once(socket, 'close')
+      socket.write([
+        `GET ${path} HTTP/1.1`,
+        `Host: 127.0.0.1:${String(port)}`,
+        'Connection: Upgrade',
+        'Upgrade: dsh-test',
+        '',
+        '',
+      ].join('\r\n'))
+      await closed
+    }
+    await refusedUpgrade('/locked/events')
+
+    // A throwing guard is contained like any per-request failure: the socket
+    // is destroyed and the server keeps serving.
+    const disposeThrowing = server.registerGuard({ upgrade: () => { throw new Error('guard blew up') } })
+    await refusedUpgrade('/events')
+    disposeThrowing()
+    expect(await request(port, '/probe')).toMatchObject({ status: 200, body: 'EXACT' })
+
+    // Disposal removes the guard (a repeated dispose is a no-op), and the
+    // formerly denied path dispatches again — to the fallback owner here.
+    disposeDeny()
+    disposeDeny()
+    disposeUpgradeOnly()
+    disposeHttpOnly()
+    expect((await request(port, '/locked/route')).body).toContain('SHELL')
+    disposeUpgradeRoute()
+  })
