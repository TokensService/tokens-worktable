+/**
+ * One pre-dispatch guard. Guards run in registration order before any route
+ * matching (and before upgrade negotiation), so a deployment can gate the
+ * whole HTTP surface — named routes, the fallback seat, and upgrade sockets
+ * alike — behind one check such as an authentication plugin.
+ */
+export interface WebGuard {
+  /**
+   * Inspect one HTTP request before route matching and optionally answer it
+   * (redirect, 401).
+   * @param req - the incoming request.
+   * @param res - the response the guard may settle.
+   * @returns true when the guard answered the request and dispatch must stop.
+   */
+  http?(req: IncomingMessage, res: ServerResponse): boolean | Promise<boolean>
+  /**
+   * Inspect one HTTP upgrade before route lookup. Synchronous: the upgrade
+   * event does not await listeners, so an upgrade guard decides from data
+   * already in hand (headers, cookies).
+   * @param req - the upgrade request.
+   * @returns true to refuse the upgrade; the socket is destroyed without negotiation.
+   */
+  upgrade?(req: IncomingMessage): boolean
+}
